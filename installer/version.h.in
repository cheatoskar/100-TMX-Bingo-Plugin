// Deliberately no example of the old form here: a quoted version number in this
// comment is the first thing a naive search finds, and the build's own check
// read it instead of the define below and then failed looking for a number that
// was never meant to be there.
#pragma once

#define TMX_VERSION L"@TMX_VERSION@"

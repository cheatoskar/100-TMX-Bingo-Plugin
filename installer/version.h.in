// Generated by CMake from installer/version.h.in - do not edit the copy.
//
// The version reaches the installer through a generated header rather than a
// `-D` string, because a string compile-definition does not survive the trip:
// `TMX_VERSION=L"0.6.4"` loses its quotes somewhere between CMake, MSBuild and
// the compiler, and the installer registered a version folder literally called
// "0". That broke a player's game - the loader picks the highest version it can
// see and found no DLL in the one it picked.
//
// A header has no quoting layers to lose, and it is checked into the build
// rather than assembled on a command line.
#pragma once

#define TMX_VERSION L"@TMX_VERSION@"
